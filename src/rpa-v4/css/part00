.lab{--bg:#080b0f;--panel:#0d1117;--panel2:#111821;--line:rgba(255,255,255,.11);--muted:#8c98a7;--text:#eef3f8;--accent:#b7f7d0;--warn:#ffd28a;min-height:100vh;background:var(--bg);color:var(--text);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;padding-bottom:72px}.lab *{box-sizing:border-box}.topbar{position:sticky;top:0;z-index:20;display:grid;grid-template-columns:1.2fr 2fr auto;gap:16px;align-items:center;padding:12px 18px;background:rgba(8,11,15,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(14px);font-size:11px}.brand{display:block;font-size:15px;font-weight:800;letter-spacing:.08em}.statusStrip{display:flex;gap:8px;flex-wrap:wrap}.statusStrip span,.decision{border:1px solid var(--line);padding:5px 7px;border-radius:5px}.decision{color:var(--warn);font-weight:600}.controlDeck,.liveTools,.graphWorkspace,.analytics,.secondaryGrid,.labFooter{width:min(1480px,calc(100% - 24px));margin:12px auto}.controlDeck{display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) auto;gap:10px;border:1px solid var(--line);background:var(--panel);padding:12px}.controlGroup{display:grid;gap:8px}.controlGroup label,.nodeInspector label{display:grid;gap:4px;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}.lab input,.lab select,.lab button{font:inherit;color:var(--text);background:#0a0f15;border:1px solid var(--line);border-radius:4px;padding:7px 9px}.lab button{cursor:pointer}.lab button:hover{border-color:rgba(183,247,208,.55)}.lab button:disabled{opacity:.35;cursor:not-allowed}.actions{display:flex;gap:6px;align-items:end;flex-wrap:wrap}.liveTools{border:1px solid var(--line);background:var(--panel);padding:10px 12px}.liveTools>div{display:flex;gap:8px}.liveTools input{flex:1}.liveTools p{margin:8px 0;color:var(--muted)}.workspace{width:min(1480px,calc(100% - 24px));margin:12px auto;display:grid;grid-template-columns:260px minmax(0,1fr) 300px;gap:10px}.sidePanel,.mapColumn,.graphWorkspace,.analytics,.toolCard{background:var(--panel);border:1px solid var(--line)}.sidePanel{padding:14px;min-width:0}.sidePanel h2{font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin:16px 0 8px;color:#c9d4df}.sidePanel h2:first-child{margin-top:0}.kv{display:grid;gap:1px;margin:0}.kv div{display:grid;grid-template-columns:1fr 1.3fr;gap:8px;padding:5px 0;border-bottom:1px solid rgba(255,255,255,.055)}.kv dt{color:var(--muted);font-size:10px}.kv dd{margin:0;text-align:right;font-size:10px;overflow-wrap:anywhere}.hidden{color:var(--warn)}.nodeInspector p{font-size:11px}.mapColumn{min-height:520px}.mapFrame{height:480px;position:relative;overflow:hidden}.googleMap{width:100%;height:100%}.geoMap{width:100%;height:100%;background:#0c1118}.geoMap rect{fill:#0c1118}.terrainLines path{stroke:rgba(142,157,174,.1);fill:none}.mapEdge,.graphEdge{stroke:rgba(196,209,222,.28);stroke-width:1;fill:none}.candidateEdge{stroke:var(--accent);stroke-width:3;fill:none}.mapNode,.graphNode{fill:#111c27;stroke:#8c98a7;stroke-width:1.5}.currentNode{fill:var(--accent);stroke:#fff;stroke-width:2}.candidateNode{fill:#152a20;stroke:var(--accent);stroke-width:2}.nodeGroup{cursor:pointer}.geoMap text,.graphSvg text{fill:#dbe5ee;font-size:10px;user-select:none}.mapLegend{display:flex;gap:14px;flex-wrap:wrap;padding:10px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}.bigPrediction{display:block;font-size:18px;margin:6px 0 10px}.bars{display:grid;gap:6px}.barRow{display:grid;grid-template-columns:minmax(70px,1fr) 1.2fr 54px;gap:7px;align-items:center;font-size:9px}.barRow>div{height:5px;background:#1a222c}.barRow i{display:block;height:100%;background:var(--accent)}.barRow strong{text-align:right}.beamRow{display:grid;grid-template-columns:1fr auto;gap:3px;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:9px}.beamRow small{grid-column:1/-1;color:var(--muted)}.graphWorkspace,.analytics{padding:14px}.panelHead{display:flex;justify-content:space-between;gap:16px;align-items:end;margin-bottom:10px}.panelHead p{margin:0;color:var(--muted);font-size:10px;text-transform:uppercase}.panelHead h2{font-size:16px;margin:3px 0 0}.graphSvg{width:100%;height:min(62vh,560px);background:var(--panel2);border:1px solid var(--line)}.featureInspector{border-top:1px solid var(--line);margin-top:12px;padding-top:12px}.featureGrid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:5px}.featureGrid>div{padding:7px;background:#0a0f15;border:1px solid rgba(255,255,255,.065);display:grid;gap:3px}.featureGrid span{font-size:9px;color:var(--muted);overflow-wrap:anywhere}.featureGrid strong{font-size:11px}.featureGrid small{font-size:8px;color:#7f8d9b}.matrixTable{display:grid;gap:5px;margin-top:8px}.matrixTable>div{display:grid;grid-template-columns:110px 120px 70px 70px 1fr;gap:8px;font-size:9px;border-bottom:1px solid rgba(255,255,255,.06);padding:5px}.analytics{margin-top:12px}.metricCards{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:6px}.metricCards>div{padding:9px;border:1px solid var(--line);background:#0a0f15;display:grid;gap:5px}.metricCards span{font-size:9px;color:var(--muted)}.metricCards strong{font-size:16px}.chartGrid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px;margin-top:9px}.chartGrid article{border:1px solid var(--line);background:#0a0f15;padding:8px}.chartGrid article>span{font-size:9px;color:var(--muted)}.spark{width:100%;height:80px;margin-top:5px}.spark polyline{stroke:var(--accent);stroke-width:1.5}.spark line{stroke:rgba(255,255,255,.12)}.emptyChart{height:80px;display:grid;place-items:center;color:var(--muted);font-size:9px}.analyticsTables{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:8px;margin-top:9px}.analyticsTables article{border:1px solid var(--line);padding:10px;background:#0a0f15}.lab table{width:100%;border-collapse:collapse;font-size:9px}.lab th,.lab td{text-align:left;padding:5px;border-bottom:1px solid rgba(255,255,255,.07)}.secondaryGrid{display:grid;grid-template-