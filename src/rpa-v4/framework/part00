export function finite(value: number, fallback = 0): number { return Number.isFinite(value) ? value : fallback; }
export function clamp(value: number, lo = 0, hi = 1): number { return Math.max(lo, Math.min(hi, value)); }
export function logSafe(value: number): number { return Math.log(Math.max(value, 1e-12)); }
export function logSumExp(values: number[]): number {
  if (!values.length) return -Infinity;
  const m = Math.max(...values);
  return m + Math.log(values.reduce((sum, v) => sum + Math.exp(v - m), 0));
}
