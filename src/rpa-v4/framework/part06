    return { trajectories: [], observations: [], validation: { format: lower.split(".").pop() ?? "unknown", trajectoryCount: 0, observations: 0, entities: 0, dateRange: [null, null], missingCoordinates: 0, missingTimestamps: 0, duplicateRows: 0, mapMatchSuccess: null, invalidTransitions: 0, graphConnected: null, candidateCoverage: null, endpointCoverage: null, errors: [error instanceof Error ? error.message : "Unable to parse upload"], warnings: [] } };
