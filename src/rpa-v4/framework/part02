  return (Object.keys(raw) as DynamicMatrixComponent["name"][]).map((name) => {
    const scale = config.fixedScale[name];
    const normalized = finite((raw[name].value - scale.mean) / Math.max(scale.scale, 1e-6));
    return { name, raw: raw[name].value, normalized, coefficient: config.coefficients[name] * (name === "movement" || name === "weather" || name === "risk" ? Math.max(0.1, context.stress) : 1), units: raw[name].units, provenance: raw[name].provenance, timestamp };
  });
}

export function generalizedResistance(matrices: DynamicMatrixComponent[]): number {
  return finite(matrices.reduce((sum, m) => sum + m.coefficient * m.normalized, 0));
}

export function distanceOnlyProbability(distances: number[], alpha: number): number[] { return stableSoftmax(distances.map((d) => -Math.max(0, alpha) * d)); }

function edgeByNodes(graph: RpaGraph, from: NodeId, to: NodeId): RpaEdge | undefined { return graph.edges.find((e) => e.from === from && e.to === to); }
function nodeById(graph: RpaGraph, id: NodeId): RpaNode { const node = graph.nodes.find((n) => n.id === id); if (!node) throw new Error(`Unknown node ${id}`); return node; }
function outEdges(graph: RpaGraph, id: NodeId): RpaEdge[] { return graph.edges.filter((e) => e.from === id && e.feasible !== false); }

export function dijkstraPath(graph: RpaGraph, start: NodeId, goal: NodeId, costFn: (edge: RpaEdge) => number = (e) => e.distanceKm): NodeId[] {
