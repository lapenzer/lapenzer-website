  const raw: Record<DynamicMatrixComponent["name"], { value: number; units: string; provenance: string }> = {
    distance: { value: edge.distanceKm, units: "km", provenance: edge.providerDistanceMeters ? "provider route distance" : "graph edge distance" },
    terrain: { value: edge.terrain ?? 0, units: "0-1 index", provenance: "edge terrain attribute" },
    movement: { value: edge.movement ?? edge.traffic ?? 0, units: "0-1 index", provenance: "movement/context attribute" },
    logistics: { value: edge.logistics ?? 0, units: "0-1 index", provenance: "logistics attribute" },
    weather: { value: edge.weather ?? 0, units: "0-1 index", provenance: "weather/context at cutoff" },
    risk: { value: edge.risk ?? 0, units: "0-1 index", provenance: "generic risk attribute" },
    interest: { value: edge.interest ?? Math.log(nodeAttractiveness(node)), units: "utility index", provenance: "posterior-independent node interest" },
