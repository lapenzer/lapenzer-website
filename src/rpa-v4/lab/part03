      <div className={styles.panelHead}><div><p>Weighted graph</p><h2>Synchronized candidate graph + Graph Lab</h2></div><div className={styles.actions}><button onClick={addGraphNode}>Add node</button><button onClick={removeSelectedNode} disabled={!selectedNode}>Remove node</button><select value={edgeTarget} onChange={(e) => setEdgeTarget(e.target.value)}><option value="">Edge target…</option>{graph.nodes.filter((n) => n.id !== selectedNode).map((n) => <option key={n.id} value={n.id}>{n.id}</option>)}</select><button onClick={addDirectedEdge} disabled={!selectedNode || !edgeTarget}>Add directed edge</button><button onClick={exportGraph}>Export graph</button></div></div>
      <svg viewBox="0 0 780 460" className={styles.graphSvg}>{graph.edges.map((e) => { const a = graphPositions.get(e.from), b = graphPositions.get(e.to); if (!a || !b) return null; const candidate = latest?.candidates.find((c) => c.edge.id === e.id); return <g key={e.id}><line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} className={candidate ? styles.candidateEdge : styles.graphEdge} style={{ strokeWidth: candidate ? 1.5 + candidate.probabilities.champion * 8 : 1 + Math.min(2, e.distanceKm / 4) }} /><text x={(a[0] + b[0]) / 2} y={(a[1] + b[1]) / 2}>{fmt(e.distanceKm, 1)}</text></g>; })}{graph.nodes.map((n) => { const p = graphPositions.get(n.id)!; const candidate = latest?.candidates.find((c) => c.node === n.id); return <g key={n.id} onClick={() => { setSelectedNode(n.id); if (candidate) setSelectedCandidate(n.id); }} className={styles.nodeGroup}><circle cx={p[0]} cy={p[1]} r={10 + Math.min(10, Math.log1p(nodeAttractiveness(n)) * 4)} className={candidate ? styles.candidateNode : currentId === n.id ? styles.currentNode : styles.graphNode} /><text x={p[0]} y={p[1] + 4} textAnchor="middle">{n.id}</text><text x={p[0]} y={p[1] + 27} textAnchor="middle">a={fmt(nodeAttractiveness(n), 2)}</text></g>; })}</svg>
      {selectedCandidateObject && <div className={styles.featureInspector}><div><p>Math inspector</p><h3>{history.at(-1)} → {selectedCandidateObject.node}</h3><p>Champion {selectedCandidateObject.champion}; p={pct(selectedCandidateObject.probabilities.champion)}; resistance={fmt(selectedCandidateObject.resistance)}; node attraction={fmt(selectedCandidateObject.nodeAttractiveness)}.</p></div><div className={styles.featureGrid}>{(Object.entries(selectedCandidateObject.featureV3Map) as Array<[string, number]>).map(([name, value], i) => <div key={name}><span>{i + 1}. {name}</span><strong>{fmt(value, 4)}</strong><small>conditional contribution {suite?.conditional.ranker ? fmt((suite.conditional.ranker.weights[i] ?? 0) * value, 4) : "—"}</small></div>)}</div><details><summary>rpa_v4_context features + dynamic matrices</summary><div className={styles.featureGrid}>{RPA_V4_CONTEXT_FEATURES.map((name, i) => <div key={name}><span>{name}</span><strong>{fmt(selectedCandidateObject.contextFeatures[i], 4)}</strong></div>)}</div><div className={styles.matrixTable}>{selectedCandidateObject.matrices.map((m) => <div key={m.name}><span>{m.name}</span><b>{fmt(m.raw)} {m.units}</b><span>z={fmt(m.normalized)}</span><span>λ={fmt(m.coefficient)}</span><small>{m.provenance}</small></div>)}</div></details>{suite?.neural.status === "trained" && <details><summary>Neural attribution (gradient × input, not causal explanation)</summary><div className={styles.featureGrid}>{neuralFeatureAttribution(suite.neural, [...selectedCandidateObject.featureV3, ...selectedCandidateObject.contextFeatures]).map((v, i) => <div key={i}><span>{i < 18 ? `v3:${Object.keys(selectedCandidateObject.featureV3Map)[i]}` : `v4:${RPA_V4_CONTEXT_FEATURES[i - 18]}`}</span><strong>{fmt(v, 4)}</strong></div>)}</div></details>}</div>}
    </section>

    <section className={styles.analytics}>
      <div className={styles.panelHead}><div><p>Statistical analytics</p><h2>Actual computed prediction, calibration and monitoring data</h2></div><div><button onClick={() => setReplayIndex(Math.max(0, replayIndex < 0 ? snapshots.length - 2 : replayIndex - 1))}>Previous</button><button onClick={() => setReplayIndex(replayIndex < 0 ? -1 : Math.min(snapshots.length - 1, replayIndex + 1))}>Next</button><button onClick={() => { const idx = residuals.findIndex((r) => r.surprise === Math.max(...residuals.map((x) => x.surprise))); if (idx >= 0) setReplayIndex(idx); }}>Jump to error</button><button onClick={() => { const idx = snapshots.findIndex((s) => s.entropy === Math.max(...snapshots.map((x) => x.entropy))); if (idx >= 0) setReplayIndex(idx); }}>High entropy</button><button onClick={() => setReplayIndex(-1)}>Live</button></div></div>
      <div className={styles.metricCards}><div><span>Next Top-1</span><strong>{pct(stats.top1)}</strong></div><div><span>Next Top-3</span><strong>{pct(stats.top3)}</strong></div><div><span>NLL</span><strong>{fmt(stats.nll, 4)}</strong></div><div><span>Brier</span><strong>{fmt(stats.brier, 4)}</strong></div><div><span>ECE</span><strong>{fmt(stats.ece, 4)}</strong></div><div><span>Candidate recall</span><strong>{pct(stats.candidateRecall)}</strong></div><div><span>Conformal coverage</span><strong>{pct(stats.conformalCoverage)}</strong></div><div><span>Abstention</span><strong>{pct(stats.abstentionRate)}</strong></div></div>
      <div className={styles.chartGrid}>{chartCatalog.map(([label, values]) => <article key={label}><span>{label}</span><Sparkline values={values} label={label} /></article>)}</div>
      <div className={styles.analyticsTables}><article><h3>Model comparison</h3>{suite ? <table><thead><tr><th>Model</th><th>Validation NLL</th><th>Status</th></tr></thead><tbody><tr><td>Conditional logit</td><td>{fmt(suite.validationNll.conditional_logit, 4)}</td><td>{suite.champion === "conditional_logit" ? "CHAMPION" : "challenger"}</td></tr><tr><td>GBM</td><td>{fmt(suite.validationNll.gbm, 4)}</td><td>{suite.champion === "gbm" ? "CHAMPION" : suite.gbm.status}</td></tr><tr><td>Setwise neural</td><td>{fmt(suite.validationNll.neural, 4)}</td><td>{suite.champion === "neural" ? "CHAMPION" : suite.neural.status}</td></tr><tr><td>MaxEnt IRL policy</td><td>{fmt(suite.irl.trainingNll, 4)}</td><td>{suite.irl.status}</td></tr></tbody></table> : <p>{trainingStatus}</p>}</article><article><h3>Safe adaptation / drift</h3><p>EWMA surprise {fmt(drift.ewmaSurprise)} · EWMA Brier {fmt(drift.ewmaBrier)} · drift {drift.drift ? "triggered" : "not triggered"}</p><p>{drift.action}</p></article><article><h3>Post-run destination evaluation</h3>{truthComplete && truthRef.current ? <><p>Hidden destination revealed: <strong>{truthRef.current.destination}</strong></p><p>Actual route: {truthRef.current.path.join(" → ")}</p><p>Final posterior history is available in replay; no destination truth entered any prediction call.</p></> : <p>Destination truth remains sealed until trajectory completion.</p>}</article></div>
    </section>

    <section className={styles.secondaryGrid}>
      <article className={styles.toolCard}><h2>Data upload + validation</h2><input type="file" accept=".csv,.json,.geojson,.gpx,.graphml" onChange={(e) => void onUpload(e.target.files?.[0])} /><p>{uploadMessage}</p>{uploadReport && <dl className={styles.kv}><div><dt>trajectories</dt><dd>{uploadReport.trajectoryCount}</dd></div><div><dt>observations</dt><dd>{uploadReport.observations}</dd></div><div><dt>entities</dt><dd>{uploadReport.entities}</dd></div><div><dt>missing coordinates</dt><dd>{uploadReport.missingCoordinates}</dd></div><div><dt>missing timestamps</dt><dd>{uploadReport.missingTimestamps}</dd></div><div><dt>duplicates</dt><dd>{uploadReport.duplicateRows}</dd></div><div><dt>invalid transitions</dt><dd>{uploadReport.invalidTransitions}</dd></div></dl>}</article>
      <article className={styles.toolCard}><h2>Controlled experiments</h2><p>Same split rules and information boundary across graph topologies. Current batch uses the selected graph parameters with deterministic seed offsets.</p><button onClick={runExperiments}>Run 4-graph batch</button>{experimentRows.length > 0 && <table><thead><tr><th>Graph</th><th>N</th><th>E</th><th>NLL</th><th>Top-1</th></tr></thead><tbody>{experimentRows.map((r) => <tr key={r.graphId}><td>{r.graphId.slice(-8)}</td><td>{r.nodes}</td><td>{r.edges}</td><td>{fmt(r.validationNll, 3)}</td><td>{pct(r.top1)}</td></tr>)}</tbody></table>}</article>
      <article className={styles.toolCard}><h2>Legacy pipeline adapters</h2>{legacyCompatibilityManifest().map((item) => <div className={styles.compat} key={item.name}><strong>{item.name}</strong><span>{item.status}</span><small>{item.input} → {item.output}</small></div>)}</article>
      <article className={styles.toolCard}><h2>API contract</h2><p>Stateless/server-side endpoints are available under <code>/api/rpa</code> for graph building, Google route matrices, observations, next-state prediction, destination prediction, beam forecasts, training, evaluation and champion promotion metadata.</p><p>Every prediction snapshot carries model, feature-schema and graph versions, cutoff timestamps, seed, latency and provenance.</p></article>
    </section>

    <footer className={styles.labFooter}><span>{trainingStatus}</span><span>Graph seed {graph.seed} · graph version {graph.graphVersion}</span><span>Exact v3 feature order preserved: {Object.keys(latest?.candidates[0]?.featureV3Map ?? {}).length || 18} features.</span></footer>
  </div>;
}
